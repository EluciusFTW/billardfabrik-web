{
  "name": "billardfabrik-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "test": "jest",
    "start": "ng serve --port 4200",
    "start-prod": "ng serve --configuration production --port 4200",
    "build": "ng build",
    "build:prod": "ng build -c production",
    "deploy": "firebase deploy",
    "cp": "copy 'sitemap.xml' 'dist/billardfabrik-web'",
    "build-and-deploy": "npm run build && npm run cp && npm run deploy"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.18",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "ng2-charts": "^5.0.3",
    "rxjs": "^7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.20",
    "@angular/cli": "^20.3.20",
    "@angular/compiler-cli": "^20.3.18",
    "@types/node": "^20.19.37",
    "typescript": "^5.8.3"
  }
}
