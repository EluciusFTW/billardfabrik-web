{
  "name": "billardfabrik-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "test": "jest",
    "start": "ng serve --port 4200",
    "start-prod": "ng serve --configuration production --port 4200",
    "build": "ng build",
    "build:prod": "ng build -c production",
    "deploy": "firebase deploy",
    "cp": "copy 'sitemap.xml' 'dist/billardfabrik-web'",
    "build-and-deploy": "npm run build && npm run cp && npm run deploy"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.24",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/fire": "^21.0.0-rc.1",
    "@angular/forms": "^21.2.24",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@angular/router": "^21.2.24",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "rxjs": "^7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@types/node": "^12.11.1",
    "typescript": "^5.9.3"
  }
}
