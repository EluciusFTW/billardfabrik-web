{
  "name": "billardfabrik-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "test": "jest",
    "start": "ng serve --port 4200",
    "start-prod": "ng serve --configuration production --port 4200",
    "build": "ng build",
    "build:prod": "ng build -c production",
    "deploy": "firebase deploy",
    "cp": "copy 'sitemap.xml' 'dist/billardfabrik-web/browser'",
    "build-and-deploy": "npm run build && npm run cp && npm run deploy"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/fire": "^21.0.0-rc.1",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "rxjs": "^7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^12.11.1",
    "firebase-tools": "^15.34.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@angular/fire": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser": "$@angular/platform-browser",
      "typescript": "$typescript"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
