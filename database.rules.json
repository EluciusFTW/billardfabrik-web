{
  "rules": {
    ".read": true,
    ".write": false,
    "tourneySeries": {
      "tourneys": {
        ".write": true
      },
      "players": {
        ".write": "auth != null"
      },
      "playerResults": {
        ".write": "auth != null"
      }
    },
    "uniqueTourneys": {
      ".write": true
    },
    "challenges": {
      ".write": "auth != null"
    },
    "liveChallenges": {
      ".write": "auth != null"
    },
    "elo": {
      ".write": "auth != null",
      "rankedmatches": {
        ".indexOn": [
          "source"
        ]
      }
    },
    "players": {
      ".write": "auth != null",
      ".indexOn": [
        "clubPlayer",
        "showForLeaderboard",
        "showForTourneys",
        "showForElo"
      ]
    }
  }
}
